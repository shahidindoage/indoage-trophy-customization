# Dropbox — stores design previews and customer uploads
# Create an app at https://www.dropbox.com/developers/apps (scoped access, files.content.write)
# Either paste a short-lived DROPBOX_ACCESS_TOKEN, or use the refresh-token flow
# (long-lived; generate with `node scripts/dropbox-auth.mjs`).
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_API_KEY=
DROPBOX_API_SECRET=

# Gmail SMTP — notifies the admin of new customizations
# GMAIL_APP_PASSWORD must be a 16-char Google App Password, not the account password
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=
